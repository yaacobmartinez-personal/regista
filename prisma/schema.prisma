// Thingstead — data model
// Single Postgres, tenant-isolated. Every tenant-scoped row carries tenantId and is
// always queried with a tenant filter (see lib/authz.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum TenantStatus {
  PENDING // created, owner email not yet verified
  ACTIVE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique // the subdomain
  name      String
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now())

  memberships   Membership[]
  invitations   Invitation[]
  events        Event[]
  registrations Registration[]
  auditLogs     AuditLog[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  memberships Membership[]
  auditLogs   AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Invitation {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       Role      @default(STAFF)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model Event {
  id              String      @id @default(cuid())
  tenantId        String
  slug            String
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime?
  // IANA zone the event happens in. Instants above are UTC; this decides the
  // wall-clock time everyone sees, so it is the same for organizer and attendee.
  timezone        String      @default("UTC")
  capacity        Int?
  waitlistEnabled Boolean     @default(false)
  status          EventStatus @default(DRAFT)
  createdAt       DateTime    @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Registration {
  id           String             @id @default(cuid())
  tenantId     String
  eventId      String
  name         String?
  email        String
  customFields Json?
  status       RegistrationStatus @default(CONFIRMED)
  checkedInAt  DateTime?
  anonymizedAt DateTime? // set when PII is erased; row kept for counts
  /// SHA-256 of the value emailed to the registrant, letting them manage their
  /// own place without an account. Cleared on erasure along with the rest.
  manageToken  String?            @unique
  /// Value encoded in the attendee's QR ticket for check-in. Stored in the clear
  /// (unlike manageToken): it only *identifies* a registration, and the check-in
  /// action is separately gated by a staff session and tenant scope — so it is
  /// not a credential, and the manage page must read it back to draw the QR.
  /// Random and unique so a ticket can't be forged or enumerated; cleared on
  /// erasure so a forgotten person's ticket stops resolving.
  checkInToken String?            @unique
  createdAt    DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([tenantId])
  @@index([eventId])
}

/// Accountability trail for access to registrant personal data.
/// Holds identifiers only — never the personal data itself.
model AuditLog {
  id          String    @id @default(cuid())
  tenantId    String
  actorUserId String?
  /// See AuditAction in lib/audit.ts for the values in use.
  action      String
  targetType  String?
  targetId    String?
  createdAt   DateTime  @default(now())

  /// Restrict, not Cascade: a log that vanished with the organization it holds
  /// accountable would be no use for answering questions afterwards. The
  /// database refuses the delete, which also enforces the rule that an address
  /// is only reclaimable when nothing has happened under it.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// The record stays even if the acting account goes; it just loses attribution.
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
}

// Owner email verification at signup (and future flows).
// `token` stores a SHA-256 hash of the value emailed to the user, so a database
// leak cannot be replayed as a verification link.
model VerificationToken {
  identifier String // the email address being verified
  token      String   @unique
  tenantId   String? // tenant to activate on success (null for non-signup flows)
  expiresAt  DateTime
  usedAt     DateTime? // single-use: set on redemption
  createdAt  DateTime  @default(now())

  @@id([identifier, token])
  @@index([tenantId])
}
